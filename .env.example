# Copia este archivo a .env y rellena los valores. NUNCA subas .env a Git.

# PostgreSQL (ej. local, Neon o Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/placa_test?schema=public"

# Autenticación del panel. ADMIN_EMAIL es el usuario de acceso; en producción la contraseña
# debe tener al menos 16 caracteres. Genera el secreto con: openssl rand -base64 32
AUTH_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Protección de la tarea programada que elimina ventas con más de 3 meses
# (más 7 días de margen para descargar la copia Excel).
# Genera un valor con: openssl rand -hex 32
SALES_RETENTION_SECRET=""

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Pagos online con Stripe Connect (destination charges).
# Claves en https://dashboard.stripe.com/apikeys (usa las de prueba sk_test_ mientras desarrollas).
STRIPE_SECRET_KEY=""
# Secreto del endpoint /api/stripe/webhook (whsec_...). En local: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=""
# Cuenta conectada de la tienda que recibe el importe del pedido (acct_...).
STRIPE_CONNECTED_ACCOUNT_ID=""

# Número de proxies inversos de confianza delante de la app que añaden la IP del cliente a
# X-Forwarded-For. Se usa para limitar intentos (login del panel y envío de opiniones).
# - 0 (por defecto): sin proxy. Se usa X-Real-IP o el último valor de X-Forwarded-For.
#   Ojo: sin proxy el cliente puede enviar esas cabeceras, así que en producción pon un proxy.
# - Vercel: 1 (Vercel sobrescribe X-Forwarded-For con la IP real del cliente).
# - nginx con `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;`: 1.
# - Dos proxies encadenados (p. ej. Cloudflare delante de nginx): 2.
# Un valor mayor que el real permite falsear la IP; uno menor agrupa a todos bajo la IP del proxy.
TRUSTED_PROXY_HOPS="0"
