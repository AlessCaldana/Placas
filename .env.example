# Copia este archivo a .env y rellena los valores. NUNCA subas .env a Git.

# PostgreSQL (ej. local, Neon o Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/placa?schema=public"

# Se usará en la Etapa 2 (autenticación). Genera uno con: openssl rand -base64 32
AUTH_SECRET=""

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
