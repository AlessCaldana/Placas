# Copia este archivo a .env y rellena los valores. NUNCA subas .env a Git.

# PostgreSQL (ej. local, Neon o Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/placa_test?schema=public"

# Autenticación del panel. Las cuentas están en la tabla admin_users (créalas con
# `npm run admin:user` o desde el panel). Genera el secreto con: openssl rand -base64 32
AUTH_SECRET=""
# Acceso inicial (bootstrap): ADMIN_EMAIL/ADMIN_PASSWORD solo funcionan mientras no existe
# ninguna cuenta; en cuanto se crea una, se ignoran. En producción además hace falta
# ADMIN_BOOTSTRAP="on" y ADMIN_PASSWORD de al menos 16 caracteres; sin ese valor el acceso
# inicial está desactivado (crea la primera cuenta con `npm run admin:user`).
# Cuando exista la primera cuenta, BORRA ADMIN_PASSWORD y ADMIN_BOOTSTRAP de la configuración.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_BOOTSTRAP=""

# Protección de la tarea programada que elimina ventas con más de 3 meses
# (más 7 días de margen para descargar la copia Excel).
# Genera un valor con: openssl rand -hex 32
SALES_RETENTION_SECRET=""

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Pagos online con Stripe Connect (destination charges).
# Claves en https://dashboard.stripe.com/apikeys (usa las de prueba sk_test_ mientras desarrollas).
STRIPE_SECRET_KEY=""
# Secreto del endpoint /api/stripe/webhook (whsec_...). En local: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=""
# Cuenta conectada de la tienda que recibe el importe del pedido (acct_...).
STRIPE_CONNECTED_ACCOUNT_ID=""

# Número de proxies inversos de confianza delante de la app que escriben la IP del cliente en
# X-Forwarded-For. Se usa para limitar intentos por IP (login del panel, pago, opiniones,
# seguimiento de pedidos, contador de visitas).
# - Vacío o 0 (desarrollo): NO se confía en ninguna cabecera, porque sin proxy el cliente puede
#   inventarse X-Forwarded-For. Los límites quedan solo por cuenta y globales. En producción
#   la app avisa en el log al primer uso.
# - Producción con nginx en el mismo servidor (recomendado): 1, con esta línea en el `location`
#   que hace proxy_pass a la app (sobrescribe lo que envíe el cliente):
#       proxy_set_header X-Forwarded-For $remote_addr;
#       proxy_set_header Host $host;   (lo necesita la comprobación de origen de las peticiones POST)
#   y la app escuchando solo en 127.0.0.1 (que nadie pueda saltarse nginx). Añade también
#   `client_max_body_size 42m;` para las fotos de productos.
# - Vercel: 1 (Vercel sobrescribe X-Forwarded-For con la IP real del cliente).
# - Dos proxies encadenados (p. ej. Cloudflare delante de nginx con
#   `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;`): 2.
# X-Real-IP no se usa nunca. Un valor mayor que el real permite falsear la IP; uno menor agrupa
# a todos bajo la IP del proxy.
TRUSTED_PROXY_HOPS="0"

# Solo desarrollo local: ADMIN_AUTH="off" permite usar el panel sin iniciar sesión, pero
# únicamente fuera de producción y desde este mismo ordenador (http://localhost:3000 o
# http://127.0.0.1:3000). Cualquier otro valor, o si falta, exige el login. En producción
# se ignora: el login es siempre obligatorio.
ADMIN_AUTH=""
