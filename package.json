    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.5",
    "mariadb": "^3.5.4",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
