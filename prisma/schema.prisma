generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNAVAILABLE
}

enum CatalogLocale {
  IT
  FR
  ES
  EN
}

enum ProductOptionType {
  SIZE
  PRICE
}

model Category {
  id           String                @id @default(uuid()) @db.Uuid
  slug         String                @unique @db.VarChar(140)
  name         String                @db.VarChar(120)
  active       Boolean               @default(true)
  parentId     String?               @db.Uuid
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     Product[]
  createdAt    DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime              @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([parentId])
  @@map("categories")
}

model CategoryTranslation {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @db.Uuid
  locale      CatalogLocale
  name        String        @db.VarChar(120)
  searchTerms String[]      @default([])
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([categoryId, locale])
  @@index([locale])
  @@map("category_translations")
}

model Product {
  id            String               @id @default(uuid()) @db.Uuid
  referenceCode String               @unique @db.VarChar(64)
  name          String               @db.VarChar(200)
  description   String?              @db.Text
  categoryId    String               @db.Uuid
  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand         String?              @db.VarChar(120)
  model         String?              @db.VarChar(120)
  size          String               @db.VarChar(80)
  price         Decimal              @db.Decimal(10, 2)
  quantity      Int?
  material      String?              @db.VarChar(120)
  status        ProductStatus        @default(DRAFT)
  images        ProductImage[]
  translations  ProductTranslation[]
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([categoryId, status])
  @@index([name])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String   @db.VarChar(500)
  altText   String?  @db.VarChar(200)
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([productId, position])
  @@map("product_images")
}

model ProductTranslation {
  id          String        @id @default(uuid()) @db.Uuid
  productId   String        @db.Uuid
  locale      CatalogLocale
  name        String        @db.VarChar(200)
  description String?       @db.Text
  searchTerms String[]      @default([])
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([productId, locale])
  @@index([locale])
  @@map("product_translations")
}

model ProductOption {
  id        String            @id @default(uuid()) @db.Uuid
  type      ProductOptionType
  value     String            @db.VarChar(100)
  createdAt DateTime          @default(now()) @db.Timestamptz(6)

  @@unique([type, value])
  @@map("product_options")
}
