generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNAVAILABLE
}

enum CatalogLocale {
  IT
  FR
  ES
  EN
}

enum OrderStatus {
  PENDING
  PAID
  NEEDS_REVIEW
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum ProductOptionType {
  SIZE
  PRICE
}

model Category {
  id           String                @id @default(uuid()) @db.Uuid
  slug         String                @unique @db.VarChar(140)
  name         String                @db.VarChar(120)
  active       Boolean               @default(true)
  parentId     String?               @db.Uuid
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     Product[]
  createdAt    DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime              @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([parentId])
  @@map("categories")
}

model CategoryTranslation {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @db.Uuid
  locale      CatalogLocale
  name        String        @db.VarChar(120)
  searchTerms String[]      @default([])
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([categoryId, locale])
  @@index([locale])
  @@map("category_translations")
}

model Product {
  id            String               @id @default(uuid()) @db.Uuid
  referenceCode String               @unique @db.VarChar(64)
  name          String               @db.VarChar(200)
  description   String?              @db.Text
  categoryId    String               @db.Uuid
  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand         String?              @db.VarChar(120)
  model         String?              @db.VarChar(120)
  size          String               @db.VarChar(80)
  price         Decimal              @db.Decimal(10, 2)
  quantity      Int?
  viewCount     Int                  @default(0)
  material      String?              @db.VarChar(120)
  status        ProductStatus        @default(DRAFT)
  images        ProductImage[]
  translations  ProductTranslation[]
  orderItems    OrderItem[]
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([categoryId, status])
  @@index([name])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String   @db.VarChar(500)
  altText   String?  @db.VarChar(200)
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([productId, position])
  @@map("product_images")
}

model ProductTranslation {
  id          String        @id @default(uuid()) @db.Uuid
  productId   String        @db.Uuid
  locale      CatalogLocale
  name        String        @db.VarChar(200)
  description String?       @db.Text
  searchTerms String[]      @default([])
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([productId, locale])
  @@index([locale])
  @@map("product_translations")
}

model ProductOption {
  id        String            @id @default(uuid()) @db.Uuid
  type      ProductOptionType
  value     String            @db.VarChar(100)
  createdAt DateTime          @default(now()) @db.Timestamptz(6)

  @@unique([type, value])
  @@map("product_options")
}

model SiteSetting {
  id                 String   @id @default("default") @db.VarChar(32)
  name               String   @db.VarChar(120)
  logoUrl            String?  @db.VarChar(500)
  email              String?  @db.VarChar(254)
  phone              String?  @db.VarChar(32)
  whatsappNumber     String?  @db.VarChar(20)
  // Shipping price per zone in euro cents. NULL = no shipping to that zone.
  shippingItalyCents Int?
  shippingEuCents    Int?
  shippingWorldCents Int?
  // Seller legal data shown in the footer (D.Lgs. 70/2003 art. 7). All optional.
  legalName          String?  @db.VarChar(160)
  // Italian Partita IVA stored as 11 digits; other EU VAT numbers keep their prefix.
  vatNumber          String?  @db.VarChar(20)
  taxCode            String?  @db.VarChar(20)
  legalAddress       String?  @db.VarChar(255)
  pecEmail           String?  @db.VarChar(254)
  reaNumber          String?  @db.VarChar(40)
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("site_settings")
}

// Online orders paid with Stripe Checkout. Amounts are euro cents.
model Order {
  id                  String      @id @default(uuid()) @db.Uuid
  // Public reference given to the buyer ("PL-" + 6 unambiguous characters).
  orderNumber         String?     @unique @db.VarChar(16)
  status              OrderStatus @default(PENDING)
  stripeSessionId     String?     @unique @db.VarChar(255)
  stripePaymentIntent String?     @db.VarChar(255)
  country             String      @db.Char(2)
  itemCount           Int
  productsCents       Int
  shippingCents       Int
  platformFeeCents    Int
  applicationFeeCents Int
  totalCents          Int
  customerEmail       String?     @db.VarChar(254)
  customerName        String?     @db.VarChar(200)
  // E.164 phone collected by Stripe Checkout (used for the WhatsApp shipping notice).
  customerPhone       String?     @db.VarChar(32)
  // App locale at checkout (it/fr/es/en/nl), to message the buyer in their language.
  locale              String?     @db.VarChar(5)
  shippingAddress     Json?
  // Company billing details collected by Stripe Checkout ("buying as a business").
  // PFdeco issues the invoice with its own software; the site only stores and shows them.
  invoiceRequested    Boolean     @default(false)
  billingBusinessName String?     @db.VarChar(200)
  billingTaxIdType    String?     @db.VarChar(16)
  billingTaxId        String?     @db.VarChar(64)
  billingAddress      Json?
  reviewReason        String?     @db.VarChar(200)
  // Shipment set by PFdeco. trackingUrl is only stored for the "other" carrier;
  // known carriers get their tracking link built from the code.
  carrier             String?     @db.VarChar(32)
  trackingNumber      String?     @db.VarChar(64)
  trackingUrl         String?     @db.VarChar(500)
  shippedAt           DateTime?   @db.Timestamptz(6)
  items               OrderItem[]
  review              Review?
  paidAt              DateTime?   @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([shippedAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?  @db.Uuid
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  referenceCode  String   @db.VarChar(64)
  name           String   @db.VarChar(200)
  unitPriceCents Int
  quantity       Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Buyer review, one per paid order. Shown publicly only after PFdeco approves it.
// Rating (1-5) and comment length (max 1000) are validated in code.
model Review {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @unique @db.Uuid
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  firstName  String       @db.VarChar(60)
  lastName   String       @db.VarChar(60)
  rating     Int
  comment    String       @db.Text
  status     ReviewStatus @default(PENDING)
  approvedAt DateTime?    @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("reviews")
}
